# Copy to backend/.env and enter NEW credentials. Never commit .env.
# Run Gradle/Java from backend/; Docker Compose loads this file too.
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USERNAME=
DB_PASSWORD=
SLAVE_DB_URL=jdbc:oracle:thin:@localhost:1522/XEPDB1
SLAVE_DB_USERNAME=
SLAVE_DB_PASSWORD=
ELASTIC_URI=http://localhost:9200
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
REDIS_HOST=localhost
REDIS_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
# AES_SECRET: 32 ASCII characters. Plan existing-data migration before rotation.
AES_SECRET=
# JWT_SECRET: at least 32 random ASCII characters.
JWT_SECRET=
EXIM_AUTH_KEY=
OPENAI_API_KEY=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PHONE=
PINECONE_API_KEY=
# Set the index host from your Pinecone console (https://...).
PINECONE_INDEX_HOST=
DEEPL_API_KEY=
JUSO_API_KEY=
FLOBANK_AP_HOST=localhost
AI_SERVER_URL=http://localhost:8000
AI_SERVER_QNA_URL=http://localhost:8001
AI_SERVER_RECO_URL=http://localhost:8000
TERMS_BASE_DIR=./files/terms
# Local Java execution only; Docker Compose uses /app/keys/firebase-sa.json.
FIREBASE_SERVICE_ACCOUNT_PATH=
